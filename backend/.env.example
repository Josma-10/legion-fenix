# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - BACKEND LEGIÓN FÉNIX
# ==============================================================================

PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=legion_fenix
DB_USER=postgres
DB_PASSWORD=postgres
# Alternativamente, puedes usar DATABASE_URL completo:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legion_fenix

# Seguridad JWT
JWT_SECRET=fenix_secret_key_produccion_cambiar
JWT_EXPIRES_IN=8h

# Almacenamiento Multimedia en la Nube (Cloudinary)
# Si se dejan vacíos o por defecto, los archivos se almacenan localmente en /uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Inteligencia Artificial Multimodal (Google Gemini Video API)
# Obtén tu clave gratuita o de pago en: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
